{
  "name": "loreley-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "sass": "^1.108.2",
    "vue": "^3.5",
    "vue-router": "~5.5",
    "vuetify": "4.3.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitejs/plugin-vue": "~6.0.11",
    "typescript": "~6.0.3",
    "vite": "~8.3.8",
    "vite-plugin-vuetify": "~2.1.3",
    "vue-tsc": "~3.3.14"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  }
}
