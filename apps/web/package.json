{
  "name": "loreley-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "sh scripts/gen-api.sh",
    "gen:api:check": "sh scripts/gen-api-check.sh"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-query": "^5.108.4",
    "sass": "^1.108.2",
    "vue": "^3.5",
    "vue-router": "~5.5",
    "vuetify": "4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "~6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "~8.3.8",
    "vite-plugin-vuetify": "~2.1.3",
    "vitest": "^5.1.2",
    "vue-tsc": "~3.3.14"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false,
    "vue-demi": false
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "minimatch": "^11.0.9",
    "glob": "^14.0.6"
  }
}
