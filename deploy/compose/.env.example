# deploy/compose/compose.yaml 用の設定例。使うときは `.env` にコピーして変える:
#   cp .env.example .env
# `.env` が無くても、ここに書いた既定値で動く。秘密値は含めない。

# OpenSearch のバージョン(パッチまで固定する。`latest` は使わない)。
OPENSEARCH_VERSION=3.9.0

# OpenSearch の JVM ヒープ(Xms と Xmx に同じ値を使う)。Docker VM のメモリの半分以下にする。
OPENSEARCH_HEAP_SIZE=512m

# ホスト側のポート。公開先は常に 127.0.0.1(ループバック)だけで、これでは変わらない。
OPENSEARCH_HOST_PORT=9200
INDEXER_HOST_PORT=8000

# Indexer のログレベル(DEBUG / INFO / WARNING / ERROR)。
INDEXER_LOG_LEVEL=INFO

# Crawler のログレベル(DEBUG / INFO / WARNING / ERROR)。
CRAWLER_LOG_LEVEL=INFO

# Crawler が読む検索対象のディレクトリ(ホスト側のパス。コンテナ内では /data/documents に読み取り専用で
# mount される)。compose.yaml のあるディレクトリからの相対パスでもよい。
# Crawler は uid 10001 で動くので、ファイルは others が読める権限(ディレクトリは実行権限も)にする。
CRAWLER_DOCUMENTS_DIR=./documents

# 索引名。opensearch-init・Indexer・Crawler(LORELEY_JOBS_INDEX_NAME は 3 者、SOURCES は
# opensearch-init と Crawler の 2 者)に同じ値が渡る。2 つは別の名前にする(同じだと Crawler が起動に失敗する)。
LORELEY_JOBS_INDEX_NAME=loreley-jobs
LORELEY_SOURCES_INDEX_NAME=loreley-sources

# Indexer の上限(既定は Indexer のコードの既定値)。Indexer と Crawler の両方に同じ値が渡る。
# Crawler は、自分の値(原本 1 件・バッチ・last-seen の件数など)がこれ以下であることを起動時に検査し、
# 超えていると起動に失敗する。値を変えるときは Crawler 側の設定(LORELEY_CRAWLER_*)も確認すること。
INDEXER_MAX_RAW_BYTES=20971520
INDEXER_MAX_BATCH_DOCUMENTS=50
INDEXER_MAX_BATCH_BYTES=67108864
INDEXER_MAX_REQUEST_BODY_BYTES=104857600
INDEXER_MAX_LAST_SEEN_IDS=1000
INDEXER_SKIP_OVERSIZE_ID_LIMIT=10000
