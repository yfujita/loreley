# deploy/compose/compose.yaml 用の設定例。使うときは `.env` にコピーして変える:
#   cp .env.example .env
# `.env` が無くても、ここに書いた既定値で動く。秘密値は含めない。

# OpenSearch のバージョン(パッチまで固定する。`latest` は使わない)。
OPENSEARCH_VERSION=3.9.0

# OpenSearch の JVM ヒープ(Xms と Xmx に同じ値を使う)。Docker VM のメモリの半分以下にする。
OPENSEARCH_HEAP_SIZE=512m

# ホスト側のポート。公開先は常に 127.0.0.1(ループバック)だけで、これでは変わらない。
OPENSEARCH_HOST_PORT=9200
INDEXER_HOST_PORT=8000

# Indexer のログレベル(DEBUG / INFO / WARNING / ERROR)。
INDEXER_LOG_LEVEL=INFO
